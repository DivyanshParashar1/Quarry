# Node env
NODE_ENV=development

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://jobforge:jobforge@localhost:5432/jobforge

# Server
PORT=3000
LOG_LEVEL=info

# Mode: 'dev' (dryRun actors) | 'live' (actors may perform side effects after approval)
MODE=dev

# LLM provider: 'claude-code' | 'openrouter'
LLM_PROVIDER=claude-code

# claude-code adapter
CLAUDE_CLI_PATH=claude
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6
CLAUDE_CONCURRENCY=2
CLAUDE_TIMEOUT_MS=120000

# openrouter adapter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4
OPENROUTER_CONCURRENCY=4
OPENROUTER_TIMEOUT_MS=120000

# Per-task model/provider routing and plugin settings live in config.yaml
# (copy config.example.yaml).

# Gmail (Phase 3): create an OAuth client of type "Desktop app" in Google Cloud and enable the Gmail API.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback
# Written by `jf gmail auth`; keep this file private.
GMAIL_REFRESH_TOKEN=
