# =============================================================================
# Quarry environment file
# =============================================================================
#
# HOW TO USE
#   1. cp .env.example .env        (.env is gitignored; never commit it)
#   2. Fill in section 1 (REQUIRED). The values below already work with the
#      bundled docker-compose.yml and the Claude Code CLI.
#   3. Pick ONE LLM provider in section 2 and uncomment what it needs.
#   4. Everything else is OPTIONAL. Commented lines show the built-in default;
#      uncomment a line only to change it or to turn a feature on.
#
# Secrets live only here (or in the OS keychain). They are never logged and
# never written to the database. Non-secret settings (per-task model routing,
# outreach limits, autopilot, schedules, plugin options) go in config.yaml;
# start from config.example.yaml. Full reference: docs/configuration.md
#
# Format: KEY=value, no spaces around "=", no quotes needed.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED
# -----------------------------------------------------------------------------

# Postgres connection. This matches docker-compose.yml (`docker compose up -d`).
# The "jobforge" names are the project's pre-rename credentials, kept because
# ./pgdata was initialised with them.
# Alternative: any Postgres 16 with the pgvector extension, e.g.
#   DATABASE_URL=postgres://user:password@db.example.internal:5432/quarry
DATABASE_URL=postgres://jobforge:jobforge@localhost:5432/jobforge

# Run mode. This is the master switch for real-world side effects.
#   dev  - every actor is a DRY RUN: emails, LinkedIn messages and applications
#          are logged and screenshotted, never sent or submitted. (default)
#   live - actors may act, but ONLY on items you approved in the review queue.
# A single CLI command can also go live with --live, without changing this.
# Leave this on dev until you have checked a few dry runs.
MODE=dev

# Which LLM does the matching, tailoring and drafting. See section 2.
#   claude-code  - your installed, logged-in Claude Code CLI (uses your Claude
#                  subscription; no API key). (default)
#   openrouter   - OpenRouter HTTP API, billed per token; needs OPENROUTER_API_KEY.
#   codex        - your installed, logged-in OpenAI Codex CLI.
#   antigravity  - your installed, logged-in Google Antigravity CLI (`agy`).
# config.yaml `llm.tasks.<task>.provider` can send single tasks elsewhere.
LLM_PROVIDER=claude-code


# -----------------------------------------------------------------------------
# 2. LLM PROVIDER  (configure the one you chose above; leave the rest commented)
# -----------------------------------------------------------------------------
# Check your setup with:  pnpm quarry llm check   (makes no model call)

# --- 2a. claude-code ---------------------------------------------------------
# Install: https://docs.claude.com/en/docs/claude-code, then run `claude` once to log in.
# Nothing to uncomment if `claude` is on your PATH; the defaults are below.
# CLAUDE_CLI_PATH=claude                    # full path if `claude` is not on PATH
# CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6    # e.g. claude-haiku-4-5 for cheaper runs
# CLAUDE_CONCURRENCY=2                      # parallel CLI processes
# CLAUDE_TIMEOUT_MS=120000                  # per call

# --- 2b. openrouter ----------------------------------------------------------
# Get a key at https://openrouter.ai/keys. REQUIRED when LLM_PROVIDER=openrouter.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # any OpenAI-compatible endpoint
# OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4 # any OpenRouter model id, e.g. google/gemini-2.5-flash
# OPENROUTER_CONCURRENCY=4
# OPENROUTER_TIMEOUT_MS=120000

# --- 2c. codex ---------------------------------------------------------------
# Install: `npm i -g @openai/codex`, then `codex login`.
# CODEX_CLI_PATH=codex
# CODEX_DEFAULT_MODEL=default               # 'default' = the model in ~/.codex/config.toml
# CODEX_CONCURRENCY=2
# CODEX_TIMEOUT_MS=180000

# --- 2d. antigravity ---------------------------------------------------------
# Install the Google Antigravity CLI, then log in once in an interactive `agy` session.
# ANTIGRAVITY_CLI_PATH=agy
# ANTIGRAVITY_DEFAULT_MODEL=default         # 'default' = the CLI's pick; `agy models` lists slugs
# ANTIGRAVITY_CONCURRENCY=2
# ANTIGRAVITY_TIMEOUT_MS=180000


# -----------------------------------------------------------------------------
# 3. GMAIL  (optional; needed for outreach emails, reply tracking, job-alert
#            emails, and verification codes during Workday/SF/Taleo applications)
# -----------------------------------------------------------------------------
# Google Cloud Console: enable the Gmail API, set up the OAuth consent screen
# (External, add yourself as a test user), create an OAuth client of type
# "Desktop app". Paste its id/secret here, then run:  pnpm quarry gmail auth
# Step-by-step: docs/outreach.md
# GMAIL_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=GOCSPX-...
# GMAIL_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback   # must match the OAuth client
#
# Written for you by `quarry gmail auth`; do not fill it in by hand. In Google's
# "Testing" mode it expires after 7 days; rerun `quarry gmail auth` when it does.
# GMAIL_REFRESH_TOKEN=


# -----------------------------------------------------------------------------
# 4. NOTIFICATIONS  (optional)
# -----------------------------------------------------------------------------
# Push a notification when something only you can fix comes up (captcha,
# expired Gmail token, LLM budget spent). They always appear in the dashboard's
# Review and Health tabs as well. Use an unguessable ntfy topic; it acts as a secret.
# NTFY_URL=https://ntfy.sh/quarry-<random-secret-topic>


# -----------------------------------------------------------------------------
# 5. SERVER AND LOGGING  (optional)
# -----------------------------------------------------------------------------
# PORT=3000                  # dashboard + API at http://localhost:<PORT>
# LOG_LEVEL=info             # trace | debug | info | warn | error | fatal
# NODE_ENV=development       # development | test | production (production = JSON logs)


# -----------------------------------------------------------------------------
# 6. TOOLS ON YOUR MACHINE  (optional; only if they are not on PATH)
# -----------------------------------------------------------------------------
# LaTeX build command for resume PDFs (install TeX Live for latexmk + pdflatex).
# LATEX_BIN=latexmk
#
# Browser for application form-filling. By default Playwright's own Chromium
# (`pnpm exec playwright install chromium`). Alternative: your installed Chrome, e.g.
#   BROWSER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# BROWSER_EXECUTABLE_PATH=
#
# Set to false to watch the browser while it fills forms (also needed for
# `quarry linkedin login`).
# BROWSER_HEADLESS=true


# -----------------------------------------------------------------------------
# 7. LINKEDIN AUTOMATION  (optional, OFF by default; leave this alone unless you
#                          know you want it)
# -----------------------------------------------------------------------------
# Referral outreach on LinkedIn is MANUAL by default: Quarry drafts messages and
# you send them yourself. Nothing here is needed for that.
#
# The older automation logs into a DEDICATED LinkedIn account (never your main
# one; LinkedIn's terms forbid automation and the account may be restricted).
# It runs only when this is true AND the run is live. Read docs/linkedin.md first.
# LINKEDIN_ENABLED=false
#
# Where the encrypted session is saved (default data/linkedin/state.enc).
# LINKEDIN_STATE_PATH=data/linkedin/state.enc
#
# Encryption key for that session file. By default the OS keychain is used
# (macOS `security`, Linux `secret-tool`), falling back to
# ~/.config/quarry/linkedin-session.key. Set this only on machines without a
# keychain: 32+ random characters, e.g. from `openssl rand -base64 48`.
# (JOBFORGE_SESSION_KEY, the pre-rename name, is still accepted.)
# QUARRY_SESSION_KEY=


# -----------------------------------------------------------------------------
# 8. DEVELOPMENT  (optional; you normally don't need these)
# -----------------------------------------------------------------------------
# Make the test suite fail instead of skipping DB tests when Postgres is down.
# QUARRY_REQUIRE_DB=1
#
# The MCP server (apps/mcp) finds the API at http://127.0.0.1:<PORT>. .mcp.json
# already sets this; change it only if the server runs elsewhere.
# QUARRY_API_URL=http://127.0.0.1:3000
