{
  "name": "@quarry/fetcher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phone-side job fetcher: runs the source plugins and writes batches the laptop imports",
  "bin": {
    "quarry-fetcher": "./src/index.ts"
  },
  "main": "./src/lib.ts",
  "exports": {
    ".": "./src/lib.ts",
    "./batch": "./src/batch.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@quarry/core": "workspace:*",
    "@quarry/matcher-default": "workspace:*",
    "@quarry/plugin-sdk": "workspace:*",
    "@quarry/shared": "workspace:*",
    "@quarry/source-ashby": "workspace:*",
    "@quarry/source-greenhouse": "workspace:*",
    "@quarry/source-lever": "workspace:*",
    "@quarry/source-smartrecruiters": "workspace:*",
    "@quarry/source-successfactors": "workspace:*",
    "@quarry/source-taleo": "workspace:*",
    "@quarry/source-workday": "workspace:*",
    "tsx": "^4.19.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "pino": "^9.14.0",
    "typescript": "^5.6.3"
  }
}
